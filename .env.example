# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase — `supabase start` prints these for a local setup
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, used for scheduled jobs and email alerts
SUPABASE_SERVICE_KEY=

# The address the app runs at (used in sign-up confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key: needed for risk scoring, gap checks and drafting
ANTHROPIC_API_KEY=

# Drift statistics service (analytics-service/)
ANALYTICS_SERVICE_URL=http://localhost:8000

# Protects the scheduled drift-check endpoint. Use a long random string.
CRON_SECRET=

# Optional: email alerts for drift breaches. Leave blank to turn email off.
RESEND_API_KEY=
EMAIL_FROM=alerts@example.com
